# Copy to .env.local. Server-only variables: never prefix them with NEXT_PUBLIC_.

# mock = demo stores from lib/store/mock-stores.ts (no backend needed)
# live = NestJS backend (tiendavirtual-backend)
API_MODE=mock

# Mock mode: which demo store to serve (aura | nova | kipu | andes)
STORE_SLUG=aura

# Live mode: backend base URL and this deployment's store API key
# API_URL=http://localhost:4000
# STORE_API_KEY=

# Live mode: Supabase Auth for customers (public values; the anon key is safe in the browser)
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live mode: Culqi public key for Culqi Checkout (the secret key goes only in the backend)
# NEXT_PUBLIC_CULQI_PUBLIC_KEY=pk_test_xxx

# Mock mode stores accounts in .data/mock-db.json (git-ignored). Demo login: see MOCK_DEMO_USER in lib/mock-db.ts
